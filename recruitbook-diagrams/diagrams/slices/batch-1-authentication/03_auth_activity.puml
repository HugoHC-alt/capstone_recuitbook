title RecruitBook Batch 1 — Authentication, Role Identity & Protected Routing

' ============================================================
' A — REGISTRATION & EMAIL VERIFICATION
' ============================================================

|#DBEAFE| User / Browser|
start
:Enter email, password,\nand select role;

|#F1F5F9| RecruitBook App|
if (Selected role allowed\nfor public registration?) then (yes — Student /\nCounselor / Admissions Officer)
else (no — Platform Administrator)
  #FEE2E2:Reject: Platform Administrator\naccounts cannot be self-registered;
  stop
endif

|#CFFAFE| Supabase Auth|
:Create auth user;

|#FEF3C7| Email Service|
:Send email verification link;

|#DCFCE7| RecruitBook Database|
:Create application user profile;\nStore role and initial account_status;

|User / Browser|
:Click email verification link;

|Supabase Auth|
:Verify email token;

|RecruitBook Database|
:Set account_status by role:\n  Student              → active\n  Counselor            → pending_approval\n  Admissions Officer   → pending_approval;

stop

' ============================================================
' B — LOGIN & ROLE-BASED REDIRECT
' ============================================================

|User / Browser|
start
:Submit credentials;

note right
  Supabase Auth handles credentials
  and sessions. Authentication is
  not authorization. RecruitBook's
  database is the source of truth
  for role and account_status.
end note

|Supabase Auth|
if (Credentials valid?) then (yes)
  :Return session token;
else (no)
  |RecruitBook App|
  #FEE2E2:Show login error;
  stop
endif

|RecruitBook App|
:Read application user profile\nfrom database;

|RecruitBook Database|
:Return profile, role, account_status;

|RecruitBook App|
if (Profile exists?) then (yes)
else (no — missing profile)
  #FEE2E2:Account recovery / error state;
  stop
endif

if (Account suspended?) then (yes)
  #FEE2E2:Redirect to Unauthorized Page;
  stop
else (no)
endif

switch (Role + account_status?)
case (Student —\nactive / verified)
  :Redirect to Student Dashboard;
case (Counselor —\npending_approval)
  :Redirect to Counselor\nPending Approval Page;
case (Counselor — verified)
  :Redirect to Counselor Dashboard;
case (Admissions Officer —\npending_approval)
  :Redirect to Admissions\nPending Approval Page;
case (Admissions Officer —\nverified)
  :Redirect to Admissions Dashboard;
case (Platform Administrator —\nactive / verified)
  :Redirect to Admin Dashboard;
case (other)
  #FEE2E2:Redirect to Unauthorized Page;
endswitch

stop

' ============================================================
' C — PROTECTED ROUTE ACCESS
' ============================================================

|User / Browser|
start
:Request protected route\n(navigation or direct URL);

note right
  Protected routes must enforce
  server-side or middleware / layout
  checks. UI hiding alone is not
  sufficient authorization.
end note

|RecruitBook App|
if (Valid Supabase session?\n(middleware / layout check)) then (yes)
else (no — missing or expired)
  :Redirect to Login Page;
  stop
endif

:Read role and account_status\nfrom database;

|RecruitBook Database|
:Return role and account_status;

|RecruitBook App|
if (Route matches required\nrole and account_status?) then (yes — authorized)
  :Render protected dashboard;
else (no — unauthorized)
  #FEE2E2:Redirect to Unauthorized Page;
endif

stop

' ============================================================
' D — PASSWORD RESET & LOGOUT
' ============================================================

|User / Browser|
start
:Select "Forgot Password"\nand enter email;

|RecruitBook App|
:Request password reset\nvia Supabase Auth;

|Supabase Auth|
:Generate single-use expiring token;

|Email Service|
:Send password reset email;

|User / Browser|
:Click reset link;

|Supabase Auth|
if (Token valid\nand not expired?) then (yes)
  :Update password hash;
else (no — expired or already used)
  |RecruitBook App|
  #FEE2E2:Show error — request new link;
  stop
endif

|RecruitBook App|
:Redirect to Login Page;
stop

' --- Logout ---

|User / Browser|
start
:Select "Log Out";

|RecruitBook App|
:Call Supabase Auth sign-out;

|Supabase Auth|
:Invalidate session token;

|RecruitBook App|
:Redirect to login / public page;
stop

