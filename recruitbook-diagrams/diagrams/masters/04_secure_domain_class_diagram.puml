title RecruitBook Secure Domain Class Diagram

left to right direction

' ============================================================
' PACKAGE: Identity & Access
' ============================================================

package "Identity & Access" {

  class "UserAccount" as UserAccount <<security>> {
    register(email: string, password: string, role: Role): EmailVerificationToken
    blockProfilePublishingUntilVerified(): Void
  }

  class "Role" as Role <<authorization>> {
    canAccess(resource: string, action: string): boolean
  }

  class "EmailVerificationToken" as EmailVerificationToken <<security>> {
    validate(): boolean
    markConsumed(): EmailVerificationToken
  }

  class "AuditLogEntry" as AuditLogEntry <<audit>> {
    recordAccessDenied(user: UserAccount, resource: object, reason: string): AuditLogEntry
  }

}

' ============================================================
' PACKAGE: Student Profile
' ============================================================

package "Student Profile" {

  class "StudentProfile" as StudentProfile <<sensitive>> {
    publish(): StudentProfile
    isVisibleToAdmissions(): boolean
    preventSelfVerifiedTranscriptUpload(): Void
  }

  class "IdentityInformation" as IdentityInformation <<sensitive>> {
  }

  class "AcademicRecord" as AcademicRecord <<sensitive>> {
  }

  class "NarrativeResponse" as NarrativeResponse <<sensitive>> {
  }

  class "ProfileItem" as ProfileItem <<trust>> {
  }

  class "ProfileVisibilitySettings" as ProfileVisibilitySettings <<privacy>> {
  }

  class "ConsentSettings" as ConsentSettings <<privacy>> {
  }

  class "VerificationTier" as VerificationTier <<trust>> {
  }

  class "SelfReportedLabel" as SelfReportedLabel <<trust>> {
  }

  class "HighSchool" as HighSchool <<institution>> {
  }

}

' ============================================================
' PACKAGE: Counselor Trust
' ============================================================

package "Counselor Trust" {

  class "CounselorInvitation" as CounselorInvitation <<security>> {
    validate(email: string): boolean
    markConsumed(): CounselorInvitation
  }

  class "CounselorProfile" as CounselorProfile <<trust>> {
    markVerified(decision: VerificationDecision): CounselorProfile
  }

  class "VerificationQueueItem" as VerificationQueueItem <<review>> {
  }

  class "VerificationDecision" as VerificationDecision <<audit>> {
    approve(admin: UserAccount, counselor: CounselorProfile, note: string): VerificationDecision
    deny(admin: UserAccount, counselor: CounselorProfile, reason: string): VerificationDecision
  }

}

' ============================================================
' PACKAGE: Transcript Support
' ============================================================

package "Transcript Support" {

  class "TranscriptSupportRequest" as TranscriptSupportRequest <<workflow>> {
    submitTranscript(counselor: CounselorProfile, file: UploadedFile): TranscriptSupportRequest
  }

  class "Transcript" as Transcript <<sensitive>> {
  }

  class "UploadedFile" as UploadedFile <<storage>> {
  }

  class "FileValidationRule" as FileValidationRule <<policy>> {
    validate(file: UploadedFile): boolean
    rejectInvalidFile(file: UploadedFile): Void
  }

}

' ============================================================
' PACKAGE: AI Review
' ============================================================

package "AI Review" {

  class "AIConsentRecord" as AIConsentRecord <<privacy>> {
    recordConsent(studentProfile: StudentProfile, consentGiven: boolean): AIConsentRecord
    withdrawConsent(studentProfile: StudentProfile): AIConsentRecord
  }

  class "AIContextualizationRequest" as AIContextualizationRequest <<workflow>> {
    validateEligibility(): boolean
  }

  class "AIContextualizationOutput" as AIContextualizationOutput <<AI-generated>> {
    labelAsAIGenerated(): AIContextualizationOutput
  }

  class "StudentAIReviewDecision" as StudentAIReviewDecision <<review>> {
    accept(output: AIContextualizationOutput): StudentAIReviewDecision
    reject(output: AIContextualizationOutput, reason: string): StudentAIReviewDecision
  }

  class "HumanReviewDecision" as HumanReviewDecision <<review>> {
    approve(reviewer: UserAccount, output: AIContextualizationOutput, note: string): HumanReviewDecision
    reject(reviewer: UserAccount, output: AIContextualizationOutput, reason: string): HumanReviewDecision
  }

  class "AIOutputPolicy" as AIOutputPolicy <<policy>> {
    canDisplay(output: AIContextualizationOutput): boolean
    hideAfterConsentWithdrawal(output: AIContextualizationOutput): AIContextualizationOutput
  }

}

' ============================================================
' PACKAGE: Admissions Discovery
' ============================================================

package "Admissions Discovery" {

  class "UniversityAccount" as UniversityAccount <<institution>> {
  }

  class "AdmissionsOfficerProfile" as AdmissionsOfficerProfile <<trust>> {
    openDiscoveryPage(): StudentDiscoverySearch
  }

  class "StudentDiscoverySearch" as StudentDiscoverySearch <<workflow>> {
    excludeHiddenProfiles(): Void
  }

  class "AdmissionsProfileView" as AdmissionsProfileView <<safe-view>> {
    render(officer: AdmissionsOfficerProfile, profile: StudentProfile): AdmissionsProfileView
  }

  class "Shortlist" as Shortlist <<privacy>> {
    addProfile(profile: StudentProfile): ShortlistEntry
  }

  class "ShortlistEntry" as ShortlistEntry <<value-object>> {
    open(officer: AdmissionsOfficerProfile): AdmissionsProfileView
  }

}

' ============================================================
' PACKAGE: Security Policies
' ============================================================

package "Security Policies" {

  class "AccessPolicy" as AccessPolicy <<policy>> {
    requireVerifiedCounselor(counselor: CounselorProfile): Void
    requireSameHighSchool(counselor: CounselorProfile, profile: StudentProfile): Void
    authorizeAdmissionsProfileView(officer: AdmissionsOfficerProfile, profile: StudentProfile): boolean
  }

  class "RowLevelSecurityPolicy" as RowLevelSecurityPolicy <<policy>> {
    enforceProfileAccess(user: UserAccount, profile: StudentProfile): boolean
  }

}

' ============================================================
' RELATIONSHIPS
' ============================================================

' --- Identity & Access ---
UserAccount "1" --> "1" Role : has
UserAccount "1" --> "0..1" StudentProfile : owns
UserAccount "1" --> "0..1" CounselorProfile : owns
UserAccount "1" --> "0..1" AdmissionsOfficerProfile : owns
UserAccount "1" --> "0..*" EmailVerificationToken : verified by

' --- Student Profile ---
StudentProfile "1" *-- "1" IdentityInformation : has
StudentProfile "1" *-- "1..*" AcademicRecord : has
StudentProfile "1" *-- "0..*" NarrativeResponse : has
StudentProfile "1" *-- "0..*" ProfileItem : has
StudentProfile "1" *-- "1" ProfileVisibilitySettings : has
StudentProfile "1" *-- "1" ConsentSettings : has
StudentProfile "1" --> "1" VerificationTier : has
StudentProfile "1" --> "0..*" SelfReportedLabel : has
StudentProfile "0..*" --> "1" HighSchool : linked to

' --- Counselor Trust ---
HighSchool "1" --> "0..*" CounselorProfile : has
CounselorInvitation "1" ..> "0..1" CounselorProfile : creates
CounselorProfile "1" --> "1" VerificationQueueItem : reviewed through
VerificationQueueItem "1" --> "0..1" VerificationDecision : resolved by

' --- Transcript Support ---
StudentProfile "1" --> "0..*" TranscriptSupportRequest : creates
TranscriptSupportRequest "0..*" --> "1" CounselorProfile : assigned to
TranscriptSupportRequest "1" --> "0..1" Transcript : produces
Transcript "1" *-- "1" UploadedFile : contains
FileValidationRule "1" ..> "0..*" UploadedFile : validates

' --- AI Review ---
StudentProfile "1" --> "0..*" AIConsentRecord : has
StudentProfile "1" --> "0..*" AIContextualizationRequest : creates
AIContextualizationRequest "1" --> "1..*" NarrativeResponse : uses
AIContextualizationRequest "1" --> "0..1" AIConsentRecord : uses
AIContextualizationRequest "1" --> "0..1" AIContextualizationOutput : produces
AIContextualizationOutput "1" --> "0..1" StudentAIReviewDecision : reviewed by
AIContextualizationOutput "1" --> "0..1" HumanReviewDecision : reviewed by
AIOutputPolicy "1" ..> "0..*" AIContextualizationOutput : controls

' --- Admissions Discovery ---
UniversityAccount "1" --> "0..*" AdmissionsOfficerProfile : has
AdmissionsOfficerProfile "1" --> "0..*" StudentDiscoverySearch : performs
AdmissionsOfficerProfile "1" --> "0..*" AdmissionsProfileView : opens
AdmissionsProfileView "1" ..> "1" StudentProfile : renders
AdmissionsProfileView "1" ..> "0..*" AIContextualizationOutput : includes
AdmissionsOfficerProfile "1" *-- "0..*" Shortlist : owns
Shortlist "1" *-- "0..*" ShortlistEntry : contains

' --- Security Policy dependencies ---
AccessPolicy "1" ..> "0..*" StudentProfile : authorizes
AccessPolicy "1" ..> "0..*" CounselorProfile : requires verified
AccessPolicy "1" ..> "0..*" AdmissionsOfficerProfile : requires approved
AccessPolicy "1" ..> "0..*" ProfileVisibilitySettings : checks
AccessPolicy "1" ..> "0..*" ConsentSettings : checks
RowLevelSecurityPolicy "1" ..> "0..*" StudentProfile : enforces

' ============================================================
' SECURITY NOTES
' ============================================================

note right of AccessPolicy
Role alone is not sufficient.
AccessPolicy checks ownership,
verification, same-school rules,
visibility, consent, and account status.
end note

note right of AIOutputPolicy
AI output is visible only after
student acceptance, human approval,
active consent, and AI-generated labeling.
end note

note right of ShortlistEntry
Saved shortlist entries must recheck
current publication, visibility,
consent, and authorization.
end note

@enduml
